# Customer Gateway with Agentic Runtime Authority (required; api.akeyless.io is rejected)
AKEYLESS_GATEWAY_URL=https://10.0.0.5:8000

# Akeyless GCP auth method bound to the Cloud Run service account
AKEYLESS_ACCESS_ID=p-xxxxxxxx
AKEYLESS_ACCESS_TYPE=gcp
AKEYLESS_GCP_AUDIENCE=akeyless.io

# Optional
# AKEYLESS_CA_BUNDLE=/etc/akeyless/ca.pem
# AKEYLESS_DEFAULT_SECRET_NAME=/prod/orders-db
# AKEYLESS_AGENT_ID=cloud-run
# PORT=8080

# Local development alternative
# AKEYLESS_ACCESS_TYPE=access_key
# AKEYLESS_ACCESS_KEY=
